<Window x:Class="Vortex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vortex" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VortexBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol panel: Agent seçimi + Workspace fayl siyahısı -->
        <Border Grid.Column="0" Background="{StaticResource VortexPanel}">
            <DockPanel Margin="14">
                <TextBlock DockPanel.Dock="Top" Text="AGENT" FontWeight="Bold"
                           Foreground="{StaticResource VortexMuted}" Margin="0,0,0,6"/>
                <ComboBox x:Name="AgentSelector" DockPanel.Dock="Top" Height="34" Margin="0,0,0,16"
                          SelectionChanged="AgentSelector_SelectionChanged"/>

                <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" FontWeight="Bold"
                           Foreground="{StaticResource VortexMuted}" Margin="0,0,0,6"/>
                <Button DockPanel.Dock="Top" Content="Yenilə" Height="28" Margin="0,0,0,8"
                        Click="RefreshWorkspace_Click"/>
                <ListBox x:Name="WorkspaceList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource VortexText}"/>
            </DockPanel>
        </Border>

        <!-- Sağ panel: Chat -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" x:Name="ChatScroll" Padding="20">
                <ItemsControl x:Name="ChatItems"/>
            </ScrollViewer>

            <Border Grid.Row="1" Background="{StaticResource VortexPanel}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInput" Grid.Column="0" Height="42" Padding="10"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource VortexBg}" Foreground="{StaticResource VortexText}"
                             BorderThickness="0" KeyDown="MessageInput_KeyDown"/>
                    <Button Grid.Column="1" Content="Göndər" Width="90" Height="42" Margin="10,0,0,0"
                            Background="{StaticResource VortexAccent}" Foreground="White" BorderThickness="0"
                            Click="SendButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
