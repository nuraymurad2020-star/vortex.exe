<Window x:Class="Vortex.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vortex - Giriş" Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource VortexBg}"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="VORTEX" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource VortexAccent}" HorizontalAlignment="Center"/>
            <TextBlock Text="Agentic AI Workspace" FontSize="12"
                       Foreground="{StaticResource VortexMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Google login backend-in /auth/google/start ünvanına yönləndirir.
             Callback uğurlu olduqda WebMessageReceived ilə tutulur. -->
        <wv2:WebView2 x:Name="LoginWebView" Grid.Row="1" Margin="12"/>
    </Grid>
</Window>
